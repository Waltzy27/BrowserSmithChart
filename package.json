{
  "name": "browser-smith-chart",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Interactive, installable Smith chart for desktop and phone browsers",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:all": "npm run build && node scripts/build-archives.mjs",
